# Base URL of the backend API.
# Local dev: leave empty/commented out — Vite's dev server proxies /api
# requests to http://localhost:8000 automatically (see vite.config.js).
# Production (e.g. Vercel): set this to your deployed backend URL,
# e.g. https://swasthya-sathi-ai-backend.onrender.com
VITE_API_URL=
