# ==============================================================================
# Swasthya Sathi AI — Environment Configuration Template
# Copy this file to backend/.env and frontend/.env respectively
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Google Gemini API key (obtain from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (e.g., gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback keys
# GEMINI_API_KEY_2=your_fallback_gemini_key
# OPENROUTER_API_KEY=your_openrouter_api_key

# Database Connection (default is local SQLite)
# DATABASE_URL=sqlite:///./swasthya.db

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# FastAPI Backend URL for Vite dev server
VITE_API_URL=http://localhost:8000
