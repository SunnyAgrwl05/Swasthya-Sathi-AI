# ==============================================================================
# Swasthya Sathi AI - Global Environment Variables Template
# ==============================================================================
# Copy this file to create your local environment configurations:
#   - For backend: copy to backend/.env
#   - For frontend: copy to frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Primary Google Gemini API Key (Required for AI operations agent chat and reports)
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Fallback Gemini API Keys (used for automatic key rotation on rate limits)
# GEMINI_API_KEY_2=your_second_gemini_key_here
# GEMINI_API_KEY_3=your_third_gemini_key_here
# GEMINI_API_KEY_4=your_fourth_gemini_key_here
# GEMINI_API_KEY_5=your_fifth_gemini_key_here

# Gemini Model Selection (defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenRouter API Key (Fallback provider for certain report flows)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Backend Server Port (defaults to 8000)
# PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------

# Backend API base URL for the React dashboard
# Local development: Leave empty or commented out.
# Vite dev server automatically proxies /api calls to http://localhost:8000.
# Production (e.g., Vercel): Set to your deployed backend URL.
# VITE_API_URL=http://localhost:8000
VITE_API_URL=
