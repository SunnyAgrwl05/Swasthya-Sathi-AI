# ============================================================
# Swasthya Sathi AI – Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit your actual .env file to version control.
# ============================================================

# ----------------------------------------------------------
# Gemini AI
# ----------------------------------------------------------
# Required. Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------
# Hallucination Detector (optional overrides)
# ----------------------------------------------------------
# Minimum confidence score to treat a response as LOW risk (default: 0.80)
# HALLUCINATION_HIGH_THRESHOLD=0.80

# Minimum confidence score to treat a response as MEDIUM risk (default: 0.60)
# Below this the response is flagged HIGH risk
# HALLUCINATION_LOW_THRESHOLD=0.60

# ----------------------------------------------------------
# Backend Server (optional)
# ----------------------------------------------------------
# Host and port for the FastAPI server (defaults to 0.0.0.0:8000)
# HOST=0.0.0.0
# PORT=8000

# ----------------------------------------------------------
# Database (optional)
# ----------------------------------------------------------
# SQLite database path (default: ./swasthya.db in backend directory)
# DATABASE_URL=sqlite:///./swasthya.db
